{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "kompiliertest": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "GOOGLE_MAPS_IOS_KEY": "PLATZHALTER",
        "GOOGLE_MAPS_ANDROID_KEY": "PLATZHALTER"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "preview": {
      "ios": { "ascAppId": "6838889246" },
      "android": { "track": "internal" }
    },
    "production": {
      "ios": { "ascAppId": "6838889246" }
    }
  }
}
