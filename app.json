{
  "expo": {
    "name": "Huta",
    "slug": "huta",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "huta",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/be64770f-2a68-467c-a3b8-abe8562e7164",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "de.dogworker.huta",
      "appleTeamId": "RW686BC248",
      "deploymentTarget": "17.0",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location", "audio"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "associatedDomains": ["applinks:dogworker-dresden.de"]
    },
    "android": {
      "package": "de.dogworker.huta",
      "adaptiveIcon": {
        "backgroundColor": "#2c2c2c",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "dogworker-dresden.de", "pathPrefix": "/huta-app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c2c2c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Huta nutzt deinen Standort für die Navigation und während einer Fahrt, damit Kunden die Ankunftszeit sehen.",
          "locationAlwaysAndWhenInUsePermission": "Huta erfasst während einer Fahrt den Standort des Fahrers, auch wenn das Handy gesperrt ist oder die App im Hintergrund läuft, damit Kunden die Ankunftszeit sehen.",
          "locationAlwaysPermission": "Huta erfasst während einer Fahrt den Standort des Fahrers, auch wenn das Handy gesperrt ist oder die App im Hintergrund läuft, damit Kunden die Ankunftszeit sehen.",
          "motionUsagePermission": "Huta nutzt Bewegungsdaten, damit die Navigation während der Fahrt genauer ist.",
          "locationFullAccuracyPermission": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#eb6a0e",
          "sounds": ["./assets/sounds/huta_bald.wav"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": { "kotlinVersion": "2.3.21" },
          "ios": { "deploymentTarget": "17.0", "useFrameworks": "dynamic" }
        }
      ],
      "@googlemaps/react-native-navigation-sdk",
      "./plugins/withGoogleMapsVersion",
      [
        "expo-camera",
        {
          "cameraPermission": "Huta nutzt die Kamera, wenn du ein Foto aufnimmst oder einen Code scannst.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Huta greift auf deine Fotos zu, wenn du ein Bild auswählst.",
          "cameraPermission": "Huta nutzt die Kamera, wenn du ein Foto aufnimmst oder einen Code scannst.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "frequentUpdates": true,
          "widgets": []
        }
      ],
      "expo-screen-orientation",
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "be64770f-2a68-467c-a3b8-abe8562e7164"
      }
    },
    "owner": "flomillo"
  }
}
